# ---------------------------------------------------------------------------
# Abuse Report Desk — environment configuration
# Copy this file to .env (or export the variables) and adjust the values.
# ---------------------------------------------------------------------------

APP_NAME="Abuse Report Desk"
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_DEBUG=false
# Secret used for session/CSRF integrity. Generate with: openssl rand -hex 32
APP_KEY=change-me-please-change-me-please

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=abuse_desk
DB_USER=abuse
DB_PASSWORD=abuse
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# The first (seeded) administrator. Login is passwordless: the app mails a
# one-time code to this address. There is no password and no username.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=tayyebimohammadreza@gmail.com

# ---------------------------------------------------------------------------
# Outgoing mail (raw-socket SMTP client, no dependencies)
# transport: smtp | log     ("log" writes .eml files to storage/outbox)
# encryption: none | tls (STARTTLS) | ssl (implicit TLS)
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM=abuse@abuse-desk.local
MAIL_FROM_NAME="Abuse Report Desk"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=15

# ---------------------------------------------------------------------------
# Inbound mail (pure-PHP IMAP4rev1 client)
# The same account can expose two mailboxes: intake + responses.
# Leave IMAP_HOST empty to disable IMAP features entirely.
# ---------------------------------------------------------------------------
IMAP_HOST=mailpit
IMAP_PORT=1143
IMAP_ENCRYPTION=none
IMAP_USER=abuse
IMAP_PASSWORD=abuse
IMAP_INTAKE_MAILBOX=INBOX
IMAP_RESPONSE_MAILBOX=INBOX
IMAP_TIMEOUT=20
# How often (seconds) the "piggyback" mailbox check may run on a page load
IMAP_CHECK_INTERVAL=300

# ---------------------------------------------------------------------------
# Public identity used in outbound reports
# ---------------------------------------------------------------------------
REPORT_REPORTER_ORG="Abuse Report Desk"
REPORT_REPORTER_DOMAIN=abuse-desk.local
REPORT_REPORTER_EMAIL=abuse@abuse-desk.local
REPORT_DEFAULT_FORMAT=arf

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE=10485760
SUBMIT_RATE_LIMIT_PER_HOUR=10
LOGIN_CODE_TTL=600
LOGIN_CODE_MAX_ATTEMPTS=5
